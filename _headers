# Netlify et Cloudflare Pages : toujours servir la dernière version de l'app et du service de rappel
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# portfolio caché : jamais indexé par les moteurs de recherche
/portfolio/*
  X-Robots-Tag: noindex, nofollow
/portfolio/assets/*
  Cache-Control: public, max-age=31536000, immutable
/tmp-store/*
  Access-Control-Allow-Origin: *
